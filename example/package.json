{
  "name": "@gaulatti/thompson-example",
  "version": "0.1.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --clear",
    "ios": "expo start --clear --ios",
    "android": "expo start --clear --android",
    "typecheck": "tsc --noEmit",
    "storybook:start": "cross-env STORYBOOK_ENABLED=true expo start --clear",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true expo start --clear --ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true expo start --clear --android",
    "storybook:export": "cross-env STORYBOOK_ENABLED=true expo export --platform ios --output-dir .storybook-build"
  },
  "dependencies": {
    "@expo-google-fonts/encode-sans": "^0.4.3",
    "@expo-google-fonts/libre-franklin": "^0.4.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.5.1",
    "@storybook/addon-ondevice-controls": "10.5.1",
    "@storybook/react-native": "10.5.1",
    "cross-env": "^10.0.0",
    "storybook": "10.5.1"
  }
}
