{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["react", "react-native"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "example/**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
